PORT=5000
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/comm_pr_db
N8N_BASE_URL=http://localhost:5678
N8N_CALLBACK_SECRET=GENERATE_A_RANDOM_SECRET
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false

# Imported into the shared n8n credential by n8n/scripts/install-local.py
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Image generation: separate from Gemini, used only by backend
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=flux

# Optional Facebook Page publishing. Local secrets may instead be stored in
# .local/facebook.env at the repository root (ignored). Existing schedules stay simulated.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v26.0
# Long-lived exchange script reads these from ignored .local/facebook.env:
# FACEBOOK_APP_ID, FACEBOOK_APP_SECRET, FACEBOOK_USER_ACCESS_TOKEN
# Signed Page feed webhook also uses FACEBOOK_WEBHOOK_VERIFY_TOKEN there.

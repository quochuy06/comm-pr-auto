generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  REJECTED
  CRISIS_ALERT
}

enum SentimentType {
  POSITIVE
  NEUTRAL
  NEGATIVE
  CRISIS
}

enum Role {
  ADMIN
  EDITOR
  REVIEWER
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EDITOR)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
}

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
  artifacts   WorkflowArtifact[]
}

model Post {
  id             String     @id @default(uuid())
  campaignId     String?
  campaign       Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  topic          String
  targetAudience String?
  tone           String?
  platform       String     @default("Facebook")
  headline       String?
  content        String?    @db.Text
  bannerUrl      String?    @db.Text
  imagePrompt    String?    @db.Text
  imageStatus    String     @default("PENDING")
  imageReviewStatus String @default("NOT_REVIEWED")
  imageReview Json?
  imageError String? @db.Text
  contentReview Json?
  risk           String     @default("UNKNOWN")
  reviewReason   String?    @db.Text
  approvedBy     String?
  latestJobId    String?
  status         PostStatus @default(DRAFT)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  publishedAt    DateTime?
  artifacts      WorkflowArtifact[]
  schedule       PostSchedule?
  comments       Comment[]
  alerts         Alert[]

  @@index([status, createdAt])
}

model Comment {
  id             String        @id @default(uuid())
  postId         String
  post           Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author         String
  text           String        @db.Text
  sentiment      SentimentType @default(NEUTRAL)
  risk           String        @default("UNKNOWN")
  sensitive      Boolean       @default(false)
  analysisStatus String        @default("PENDING")
  reason         String?       @db.Text
  suggestedReply String?       @db.Text
  replyText      String?       @db.Text
  replyStatus    String        @default("NONE")
  moderated      Boolean       @default(false)
  latestJobId    String?
  createdAt      DateTime      @default(now())

  @@index([postId, createdAt])
}

model Alert {
  id           String    @id @default(uuid())
  postId       String
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  trigger      String    @db.Text
  evidence     Json
  status       String    @default("OPEN")
  summary      String?   @db.Text
  statement    String?   @db.Text
  actions      Json?
  reviewReason String?   @db.Text
  latestJobId  String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([postId, status])
}

model WorkflowJob {
  id        String   @id @default(uuid())
  kind      String
  mode      String @default("CONTENT")
  imageAsset Json?
  entityId  String
  status    String   @default("QUEUED")
  error     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityId, createdAt])
}

model Settings {
  id                String   @id @default("default")
  mode              String   @default("CONDITIONAL")
  negativeThreshold Int      @default(3)
  windowMinutes     Int      @default(30)
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  entityId  String
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Durable output of planning, repurposing and reporting jobs.
model WorkflowArtifact {
  dedupeKey     String? @unique
  id            String   @id @default(uuid())
  kind          String
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sourcePostId  String?
  sourcePost    Post? @relation(fields: [sourcePostId], references: [id], onDelete: SetNull)
  input         Json
  result        Json?
  createdPosts  Json?
  status        String   @default("PROCESSING")
  latestJobId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([kind, createdAt])
}

model PostSchedule {
  id          String   @id @default(uuid())
  postId      String   @unique
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  contentHash String
  status      String   @default("PENDING")
  error       String?  @db.Text
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, scheduledAt])
}

{
  "name": "Huy · 02 · Đăng bài theo lịch",
  "nodes": [
    {
      "id": "publish-1",
      "name": "01 Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "publish-2",
      "name": "02 Manual authenticated tick",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "publish-due",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "comm-pr-publisher",
      "credentials": {
        "httpHeaderAuth": {
          "id": "comm-pr-callback",
          "name": "Comm PR Internal Token"
        }
      }
    },
    {
      "id": "publish-3",
      "name": "03 Fetch due schedules",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "http://172.17.0.1:5000/api/workflow-internal/due",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "comm-pr-callback",
          "name": "Comm PR Internal Token"
        }
      }
    },
    {
      "id": "publish-4",
      "name": "04 Validate schedule batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        0
      ],
      "parameters": {
        "jsCode": "if(!Array.isArray($json.schedules)||$json.schedules.length>50)throw new Error('Invalid schedule batch');return {json:$json};"
      }
    },
    {
      "id": "publish-5",
      "name": "05 Has due schedules",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        0,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-due",
              "leftValue": "={{ $json.schedules.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "publish-6",
      "name": "06 Expand due items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        220
      ],
      "parameters": {
        "jsCode": "return $json.schedules.map(s=>({json:s}));"
      }
    },
    {
      "id": "publish-7",
      "name": "07 Bind schedule revision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        220
      ],
      "parameters": {
        "jsCode": "return $input.all().map(item=>{const s=item.json;if(typeof s.id!=='string'||!s.updatedAt)throw new Error('Missing schedule revision');return {json:{id:s.id,expectedUpdatedAt:s.updatedAt}};});"
      }
    },
    {
      "id": "publish-8",
      "name": "08 Publish atomically",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "http://172.17.0.1:5000/api/workflow-internal/publish",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "comm-pr-callback",
          "name": "Comm PR Internal Token"
        }
      }
    },
    {
      "id": "publish-9",
      "name": "09 Check publication results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        440
      ],
      "parameters": {
        "jsCode": "return $input.all().map(i=>{if(!['PUBLISHED','FAILED','IGNORED','NOT_DUE'].includes(i.json.status))throw new Error('Unexpected publishing result');return i;});"
      }
    },
    {
      "id": "publish-10",
      "name": "10 Summarize outcomes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        440
      ],
      "parameters": {
        "jsCode": "const rows=$input.all().map(i=>i.json);return {json:{published:rows.filter(x=>x.status==='PUBLISHED').length,failed:rows.filter(x=>x.status==='FAILED').length,ignored:rows.filter(x=>['IGNORED','NOT_DUE'].includes(x.status)).length}};"
      }
    },
    {
      "id": "publish-11",
      "name": "11 Empty batch summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        440
      ],
      "parameters": {
        "jsCode": "return {json:{published:0,failed:0,ignored:0}};"
      }
    },
    {
      "id": "publish-12",
      "name": "12 Record execution summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,
        440
      ],
      "parameters": {
        "method": "POST",
        "url": "http://172.17.0.1:5000/api/workflow-internal/publisher-log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "comm-pr-callback",
          "name": "Comm PR Internal Token"
        }
      }
    }
  ],
  "connections": {
    "01 Every minute": {
      "main": [

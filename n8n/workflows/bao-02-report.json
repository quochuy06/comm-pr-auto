    {
      "id": "report-12",
      "name": "12 Validate reviewer response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        260
      ],
      "parameters": {
        "jsCode": "function aiFailure(r){const e=r.error;if(!e)return null;const m=typeof e==='string'?e:(e.message||'');const code=Number(e.status||e.httpCode||e.response?.status||m.match(/^(\\d{3})\\s*-/)?.[1]);if(code===429)return 'Gemini đã chạm hạn mức (HTTP 429). Hãy chờ hạn mức phục hồi rồi thử lại.';if(code===503)return 'Gemini đang quá tải (HTTP 503). Hãy thử lại sau.';if(code===401||code===403)return 'Gemini từ chối xác thực hoặc quyền truy cập. Kiểm tra credential và project.';if(code===404)return 'Model Gemini không khả dụng cho project này. Kiểm tra GEMINI_MODEL.';if(/timeout|timed out/i.test(m)||e.code==='ECONNABORTED')return 'Gemini quá thời gian chờ 60 giây. Hãy thử lại sau.';return 'Không gọi được Gemini. Kiểm tra kết nối và cấu hình dịch vụ.';} const previous=$('08 Validate generated fields').first().json;let review=null;try{review=JSON.parse(($json.candidates?.[0]?.content?.parts?.filter(p=>!p.thought).map(p=>p.text||'').join('')||'').replace(/^```(?:json)?\\s*|```$/g,'').trim());}catch{} const valid=review&&typeof review.safe==='boolean'&&typeof review.grounded==='boolean'&&['LOW','MEDIUM','HIGH'].includes(review.risk)&&typeof review.reason==='string';return {json:{...previous,ok:!!valid,review:valid?review:null,error:valid?null:(aiFailure($json)||'Bước kiểm tra AI trả kết quả không hợp lệ; không tự động duyệt.')}};"
      }
    },
    {
      "id": "report-13",
      "name": "13 Apply review decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        520
      ],
      "parameters": {
        "jsCode": "if($json.ok){$json.result.review=$json.review; $json.result.autoEligible=$json.review.safe===true&&$json.review.grounded===true&&$json.review.risk==='LOW';}return {json:$json};"
      }
    },
    {
      "id": "report-14",
      "name": "14 Prepare deliverable",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        520
      ],
      "parameters": {
        "jsCode": "if($json.ok){$json.result.requiresHuman=true;}return {json:$json};"
      }
    },
    {
      "id": "report-15",
      "name": "15 Build authenticated callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        520
      ],
      "parameters": {
        "jsCode": "return {json:{jobId:$json.jobId,entityId:$json.entityId,kind:$json.kind,ok:$json.ok===true,result:$json.ok?$json.result:null,error:$json.error||null}};"
      }
    },

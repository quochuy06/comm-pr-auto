    {
      "id": "g1-16",
      "name": "16 Build ingest result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        480
      ],
      "parameters": {
        "jsCode": "const x=$json;const env=$('02 Validate identifiers').first().json.env;const r=x.data;if(!r||!r.versionId||!Number.isSafeInteger(r.chunkCount))return {json:{env,status:'FAILED',error:{code:'DRAFT_SAVE_FAILED',message:'Không lưu được bản nháp.'},sources:[]}};return {json:{env,status:'SUCCEEDED',result:{documentId:env.context.documentId,extractionStatus:'OK',chunkCount:r.chunkCount,versionId:r.versionId},sources:[]}};"
      }
    },
    {
      "id": "g1-17",
      "name": "17 Build failure result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        480
      ],
      "parameters": {
        "jsCode": "const x=$json;const env=x.env||$('02 Validate identifiers').first().json.env;const f=x.fail||{code:'WORKFLOW_ERROR',message:'Bước xử lý không hoàn tất; không có kết quả để lưu.'};return {json:{env,status:'FAILED',error:{code:f.code,message:String(f.message).slice(0,1000)},sources:[]}};"
      }
    },
    {
      "id": "g1-18",
      "name": "18 Build callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        480
      ],
      "parameters": {
        "jsCode": "const x=$json;const e=x.env;const cb={contractVersion:1,jobId:e.jobId,attemptId:e.attemptId,kind:e.kind,pageId:e.pageId,entityId:e.entityId,correlationId:e.correlationId,versions:e.versions,context:e.context,status:x.status,sources:x.sources||[]};if(x.status==='SUCCEEDED'||x.status==='PARTIAL'){cb.result=x.result;}else{cb.error=x.error;}return {json:cb};"
      }
    },

      ],
      "parameters": {
        "method": "POST",
        "url": "http://172.17.0.1:5000/api/workflow-internal/knowledge/extract",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "comm-pr-callback",
          "name": "Comm PR Internal Token"
        }
      },
      "continueOnFail": true
    },
    {
      "id": "g1-10",
      "name": "10 Validate extraction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        240
      ],
      "parameters": {
        "jsCode": "const x=$json;const env=$('02 Validate identifiers').first().json.env;const r=x.data;if(!r||r.extractionStatus!=='OK'||typeof r.text!=='string'||!r.text.trim())return {json:{env,fail:{code:'EXTRACTION_FAILED',message:(r&&r.reason)||'Không trích xuất được văn bản từ tệp.'}}};return {json:{env,raw:r.text}};"
      }
    },
    {
      "id": "g1-11",
      "name": "11 Extraction ok",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1040,
        240
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "11 Extraction ok",
              "leftValue": "={{ !$json.fail }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "g1-12",
      "name": "12 Normalize and chunk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        240
      ],
      "parameters": {
        "jsCode": "const x=$json;const clean=String(x.raw).replace(/\\r\\n/g,'\\n').replace(/[ \\t]+/g,' ').replace(/\\n{3,}/g,'\\n\\n').trim();if(!clean)return {json:{env:x.env,fail:{code:'EMPTY_TEXT',message:'Văn bản rỗng sau chuẩn hóa.'}}};const chunks=[];let rest=clean;while(rest.length&&chunks.length<500){let cut=rest.length<=1200?rest.length:rest.lastIndexOf(' ',1200);if(cut<200)cut=1200;const piece=rest.slice(0,cut).trim();if(piece)chunks.push({ordinal:chunks.length+1,text:piece,locator:'workflow:upload#'+(chunks.length+1)});rest=rest.slice(cut).trim();}if(!chunks.length||chunks.length>500)return {json:{env:x.env,fail:{code:'CHUNKING_FAILED',message:'Tách đoạn không hợp lệ.'}}};return {json:{env:x.env,chunks}};"
      }
    },
    {
      "id": "g1-13",
      "name": "13 Chunking ok",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [

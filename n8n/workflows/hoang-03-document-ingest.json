        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "ingest-document",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "comm-pr-ingest-document",
      "credentials": {
        "httpHeaderAuth": {
          "id": "comm-pr-callback",
          "name": "Comm PR Internal Token"
        }
      }
    },
    {
      "id": "g1-2",
      "name": "02 Validate identifiers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "const b=$json.body;const id=v=>typeof v==='string'&&/^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$/.test(v);const ver=v=>Number.isSafeInteger(v)&&v>=1;if(!b||b.contractVersion!==1||!id(b.jobId)||!id(b.attemptId)||!id(b.pageId)||!id(b.entityId)||!id(b.correlationId)||!b.versions||!ver(b.versions.input)||!ver(b.versions.config)||!ver(b.versions.content)||!b.context||typeof b.context!=='object'||Array.isArray(b.context))throw new Error('Invalid workflow input');if(b.kind!==\"knowledge.ingest\")throw new Error('Wrong workflow kind');if(!id(b.context.documentId)||Object.keys(b.context).length!==1)throw new Error('Invalid ingest context');return {json:{env:b}};"
      }
    },
    {
      "id": "g1-3",
      "name": "03 Limit context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "jsCode": "const e=$json.env;const raw=JSON.stringify(e.context);if(raw.length>30000)throw new Error('Context too large');return {json:{...$json,startedAt:new Date().toISOString()}};"
      }
    },
    {
      "id": "g1-4",
      "name": "04 Build metadata request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "jsCode": "const e=$json.env;return {json:{env:e,request:{documentId:e.context.documentId,pageId:e.pageId}}};"
      }
    },
    {
      "id": "g1-5",
      "name": "05 Fetch document metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://172.17.0.1:5000/api/workflow-internal/knowledge/document-meta",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "comm-pr-callback",
          "name": "Comm PR Internal Token"
        }
      },
      "continueOnFail": true
    },
    {
      "id": "g1-6",
      "name": "06 Validate metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        0
      ],
      "parameters": {
        "jsCode": "const x=$json;const env=$('02 Validate identifiers').first().json.env;const r=x.data;if(!r||!r.document||!r.sourceFile)return {json:{env,fail:{code:'SOURCE_MISSING',message:'Tài liệu chưa có tệp nguồn hợp lệ.'}}};if(r.document.archived)return {json:{env,fail:{code:'DOCUMENT_ARCHIVED',message:'Tài liệu đã lưu trữ; không xử lý tiếp.'}}};const f=r.sourceFile;if(!Number.isSafeInteger(f.sizeBytes)||f.sizeBytes<=0||f.sizeBytes>5*1024*1024)return {json:{env,fail:{code:'FILE_TOO_LARGE',message:'Tệp rỗng hoặc vượt giới hạn 5 MB.'}}};if(!/^[a-f0-9]{64}$/.test(f.sha256||''))return {json:{env,fail:{code:'CHECKSUM_INVALID',message:'Checksum tệp nguồn không hợp lệ.'}}};return {json:{env,meta:r}};"
      }
    },
    {
      "id": "g1-7",
      "name": "07 Metadata valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        0,
        240
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "07 Metadata valid",
              "leftValue": "={{ !$json.fail }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "g1-8",
      "name": "08 Build parse request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        240
      ],
      "parameters": {
        "jsCode": "const x=$json;return {json:{env:x.env,request:{documentId:x.env.context.documentId,pageId:x.env.pageId}}};"
      }
    },
    {
      "id": "g1-9",
      "name": "09 Parse with backend",
      "type": "n8n-nodes-base.httpRequest",

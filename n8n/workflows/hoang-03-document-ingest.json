          },
          "conditions": [
            {
              "id": "13 Chunking ok",
              "leftValue": "={{ !$json.fail }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },

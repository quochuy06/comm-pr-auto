      "parameters": {
        "jsCode": "const d=$json.result;const ok=!!d&&(typeof d.headline==='string' && d.headline.length>0 && typeof d.content==='string' && d.content.length>0 && typeof d.imagePrompt==='string' && d.imagePrompt.length>10 && ['LOW','MEDIUM','HIGH'].includes(d.risk));return {json:{...$json,ok,error:ok?null:($json.serviceError||'AI trả kết quả sai cấu trúc JSON. Hãy thử lại sau.')}};"
      }

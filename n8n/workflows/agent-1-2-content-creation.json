    {
      "id": "content-8",
      "name": "06 Extract model response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        260
      ],
      "parameters": {
        "jsCode": "function aiFailure(r){const e=r.error;if(!e)return null;const m=typeof e==='string'?e:(e.message||'');const code=Number(e.status||e.httpCode||e.response?.status||m.match(/^(\\d{3})\\s*-/)?.[1]);if(code===429)return 'Gemini đã chạm hạn mức (HTTP 429). Hãy chờ hạn mức phục hồi rồi thử lại.';if(code===503)return 'Gemini đang quá tải (HTTP 503). Hãy thử lại sau.';if(code===401||code===403)return 'Gemini từ chối xác thực hoặc quyền truy cập. Kiểm tra credential và project.';if(code===404)return 'Model Gemini không khả dụng cho project này. Kiểm tra GEMINI_MODEL.';if(/timeout|timed out/i.test(m)||e.code==='ECONNABORTED')return 'Gemini quá thời gian chờ 60 giây. Hãy thử lại sau.';return 'Không gọi được Gemini. Kiểm tra kết nối và cấu hình dịch vụ.';} const r=$json; const text=r.candidates?.[0]?.content?.parts?.filter(p=>!p.thought).map(p=>p.text||'').join('')||''; return {json:{...$('03 Limit context').first().json,raw:text,serviceError:aiFailure(r)}};"
      }
    },
    {
      "id": "content-9",
      "name": "07 Parse model JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        260
      ],
      "parameters": {
        "jsCode": "let result=null;try{result=JSON.parse($json.raw.replace(/^```(?:json)?\\s*|```$/g,'').trim());}catch{} return {json:{...$json,result}};"
      }
    },

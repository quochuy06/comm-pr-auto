      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "const b=$json.body; if(!b||typeof b.jobId!=='string'||typeof b.entityId!=='string'||!b.context) throw new Error('Invalid workflow input'); return {json:{jobId:b.jobId,entityId:b.entityId,context:b.context,kind:\"content\"}};"
      }
    },
    {
      "id": "content-3",
      "name": "03 Limit context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "jsCode": "const x=$json; const raw=JSON.stringify(x.context); if(raw.length>30000) throw new Error('Context too large'); return {json:{...x,contextText:raw,startedAt:new Date().toISOString()}};"
      }
    },
    {
      "id": "content-4",
      "name": "03a Image-only request",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "image-only",
              "leftValue": "={{ $json.context.mode !== \"CONTENT\" }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}

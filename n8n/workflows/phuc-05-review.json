{
  "name": "Phúc · 05 · Cổng duyệt phản hồi",
  "nodes": [
    {
      "id": "phuc-05-review-1",
      "name": "Check periodically",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      }
    },
    {
      "id": "phuc-05-review-2",
      "name": "Run in QA",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {}
    },
    {
      "id": "phuc-05-review-3",
      "name": "Read next batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://172.17.0.1:5000/api/workflow-internal/advice/review/candidates",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 25000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "comm-pr-callback",
          "name": "Comm PR Internal Token"
        }
      }
    },
    {
      "id": "phuc-05-review-4",
      "name": "Validate and split candidate IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "\n    if ($json.success !== true || !Array.isArray($json.data)) throw new Error(\"Invalid advice batch\");\n    const candidates = $json.data.slice(0, 20);\n    return candidates.flatMap(item => {\n      if (typeof item.id !== \"string\" || !/^[0-9a-f-]{36}$/i.test(item.id)) return [];\n      return [{ json: item, pairedItem: 0 }];\n    });\n  ",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "phuc-05-review-5",
      "name": "Process one candidate at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        960,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "phuc-05-review-6",
      "name": "Return execution summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "return [{ json: { processed: $input.all().length } }];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "phuc-05-review-7",
      "name": "Apply verified gate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://172.17.0.1:5000/api/workflow-internal/advice/review/gate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $json.id }) }}",
        "options": {
          "timeout": 25000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "comm-pr-callback",
          "name": "Comm PR Internal Token"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "phuc-05-review-8",
      "name": "Record step result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "jsCode": "return { json: { outcome: $json.data?.status || 'PROCESSED' } };",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "phuc-05-review-9",
      "name": "Leave retryable work in its queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "jsCode": "return { json: { outcome: 'ERROR' } };",
        "mode": "runOnceForEachItem"
      }
    }
  ],
